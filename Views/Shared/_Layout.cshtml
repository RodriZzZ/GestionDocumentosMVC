<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GD UTEC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="@(Session["UserId"] != null ? Url.Action("Index", "Home") : Url.Action("Login", "Auth"))">GD-UTEC MVC</a>

            <div class="collapse navbar-collapse">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (Session["UserId"] != null)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Mis Documentos", "Index", "Document", new { area = "" }, new { @class = "nav-link" })
                        </li>

                        if (Session["UserRole"] != null && (int)Session["UserRole"] == 1)
                        {
                            <li class="nav-item">
                                @Html.ActionLink("Gestión de Usuarios", "Index", "User", new { area = "" }, new { @class = "nav-link" })
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (Session["UserId"] != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-white">Hola, @Session["UserName"]</span>
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Cerrar Sesión", "Logout", "Auth", new { area = "" }, new { @class = "nav-link text-danger fw-bold" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Grupo 09 UTEC</p>
        </footer>
    </div>
</body>
</html>