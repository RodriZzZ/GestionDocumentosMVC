@model GestionDocumentosMVC.Models.RecoverPasswordViewModel

@{
    ViewBag.Title = "Recuperar Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .recovery-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .input-pill {
        border-radius: 50px !important;
        padding: 12px 20px;
        background-color: #f8f9fa;
    }

    .btn-pill {
        border-radius: 50px;
        padding: 12px;
        font-weight: bold;
    }
</style>

<div class="container recovery-container">
    <div class="card shadow-lg border-0" style="width: 100%; max-width: 450px; border-radius: 20px;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock text-primary" style="font-size: 3rem;"></i>
                <h3 class="fw-bold mt-2">Recuperar Contraseña</h3>
                <p class="text-muted small">Ingresa tu correo institucional y generaremos una contraseña temporal para ti.</p>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="mb-4 text-center">
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control input-pill text-center", placeholder = "ejemplo@utec.edu.sv" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary btn-pill shadow-sm">Recuperar Acceso</button>
                </div>

                <div class="text-center">
                    @Html.ActionLink("Volver al Inicio de Sesión", "Login", "Auth", null, new { @class = "text-decoration-none text-muted small" })
                </div>
            }
        </div>
    </div>
</div>