@model GestionDocumentosMVC.Models.DocumentUploadModel

@{
    ViewBag.Title = "Subir Documento";
}

<h2>Subir Nuevo Documento</h2>

@using (Html.BeginForm("Create", "Document", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            @Html.LabelFor(model => model.File, new { @class = "form-label" })
            <input type="file" name="File" class="form-control" required />
            @Html.ValidationMessageFor(model => model.File, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <input type="submit" value="Subir Archivo al Servidor" class="btn btn-success" />
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
}