@model GestionDocumentosMVC.Models.ShareDocumentViewModel

@{
    ViewBag.Title = "Compartir Documento";
}

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0"><i class="bi bi-share"></i> Compartir Documento</h4>
    </div>
    <div class="card-body p-4">
        <p class="text-muted">Configura los accesos para el documento: <strong class="text-dark">@Model.DocumentName</strong></p>

        @using (Html.BeginForm("Share", "Document", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.DocumentId)

            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.SelectedUserId, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.SelectedUserId, Model.UsersList, "Seleccione un Usuario...", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.SelectedUserId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    @Html.LabelFor(m => m.PermissionId, new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.PermissionId, Model.PermissionsList, "Seleccione un Permiso...", new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(m => m.PermissionId, "", new { @class = "text-danger" })
                    <div class="form-text">Read: Solo puede descargar. Write: Puede subir nuevas versiones.</div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Otorgar Acceso</button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary ms-2" })
            </div>
        }
    </div>
</div>