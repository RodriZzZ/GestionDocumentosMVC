@model GestionDocumentosMVC.Models.UpdateDocumentViewModel

@{
    ViewBag.Title = "Actualizar Versión";
}

<h2>Actualizar Documento</h2>
<p class="text-muted">Estás a punto de subir una nueva versión para el documento: <strong>@Model.DocumentName</strong></p>

@using (Html.BeginForm("UpdateVersion", "Document", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal card shadow-sm mt-4 p-4">
        @Html.ValidationSummary(true, "", new { @class = "text-danger fw-bold" })

        @Html.HiddenFor(m => m.DocumentId)
        @Html.HiddenFor(m => m.DocumentName)

        <div class="mb-3">
            @Html.LabelFor(m => m.File, new { @class = "form-label fw-bold" })
            <input type="file" name="File" class="form-control" required />
            @Html.ValidationMessageFor(m => m.File, "", new { @class = "text-danger" })
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-warning"><i class="bi bi-upload"></i> Subir Nueva Versión</button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary ms-2" })
        </div>
    </div>
}